# =============================================================================
# Round 2: sequential projectile impacts on a slab with the current NEP.
#
# round2_1_build_md_inputs.py copies this file into each run folder as in.lmp
# next to:
#   params.lmp            every number used below
#   start.data            the target slab, 1 A above z = 0, empty box above it
#   impacts/impact_K.lmp  create_atoms + velocity for impact K (K = 1..n_impacts):
#                         species, energy, angle and aim point were drawn by the
#                         builder and are listed in run.json
#
# Layers of the slab (z measured in the box)
#   z < z_fix            fixed: zero force and velocity (the "bulk" below)
#   z_fix .. z_bath      Langevin bath at T_sub: carries the impact heat away
#   z > z_bath           plain NVE, like every projectile, so the impact itself
#                        is not thermostatted
#
# Each impact
#   - the projectile appears rc + a gap above the initial surface, so it starts
#     outside the NEP cutoff
#   - n_fast steps with a dump every every_fast steps: approach and impact
#   - n_slow steps with a dump every every_slow steps: the surface relaxes and
#     cools before the next projectile
#   - fix dt/reset keeps every atom under xmax per step, so a 50 eV N
#     projectile runs at ~0.15 fs and the thermalised surface at dtmax
# The surface keeps what earlier impacts did to it, so later impacts hit
# adatoms, clusters, vacancies and implanted atoms -- not only the perfect slab.
# z is non-periodic: atoms reflected or sputtered out of the top are deleted.
#
# The run stops with an error (fix halt) when PE/atom drops below epa_floor
# or any pair gets closer than d_halt. No temperature check here: a 50 eV
# projectile alone heats 130 atoms by thousands of kelvin for a moment.
#
# Run from the run folder:   lmp -in in.lmp -log log.lammps
# =============================================================================

units           metal
atom_style      atomic
boundary        p p f

include         params.lmp
read_data       ${data_file}

pair_style      nep
pair_coeff      * * ${nep_file} ${elements}

neighbor        2.0 bin
neigh_modify    every 1 delay 0 check yes

region          rfix  block INF INF INF INF INF ${z_fix} units box
region          rbath block INF INF INF INF ${z_fix} ${z_bath} units box
group           fixed region rfix
group           bath  region rbath
group           mobile subtract all fixed

velocity        mobile create ${T_sub} ${seed} dist gaussian mom yes rot no
velocity        fixed set 0.0 0.0 0.0
# the plain NEP forces, stored BEFORE setforce and langevin below change them:
# the dump writes these, so the harvester, the committee comparison and the
# NEP-vs-DFT check all see what the potential predicts, not the thermostat
fix             fstore all store/force
fix             freeze fixed setforce 0.0 0.0 0.0
# integrates everything, including atoms created later; the fixed atoms have
# zero force and zero velocity, so they stay where they are
fix             md all nve
fix             bath bath langevin ${T_sub} ${T_sub} 0.1 ${seed} zero yes
timestep        ${dtmax}
fix             dtr all dt/reset 1 NULL ${dtmax} ${xmax} units box

compute         pairs all pair/local dist
compute         dmin all reduce min c_pairs inputs local
variable        epa equal pe/atoms
variable        bad equal "(v_epa < v_epa_floor) || (c_dmin < v_d_halt)"
fix             halt all halt 10 v_bad > 0.5 error hard message yes

compute         pea all pe/atom
compute         tmob mobile temp
thermo          500
thermo_style    custom step time dt temp c_tmob pe ke atoms
thermo_modify   flush yes lost ignore norm no

# --- equilibrate the substrate at T_sub ---------------------------------------
print           "MD_STAGE equil step $(step)"
run             ${n_equil}

dump            d all custom ${every_slow} dump.collision.lammpstrj &
                id type x y z vx vy vz f_fstore[1] f_fstore[2] f_fstore[3] c_pea
dump_modify     d sort id

# --- impacts ------------------------------------------------------------------
variable        k loop ${n_impacts}
label           impact_loop
  print         "MD_IMPACT ${k} step $(step) time $(time:%.5f)"
  include       impacts/impact_${k}.lmp
  dump_modify   d every ${every_fast}
  run           ${n_fast}
  print         "MD_RELAX ${k} step $(step) time $(time:%.5f)"
  dump_modify   d every ${every_slow}
  run           ${n_slow}
  next          k
  jump          SELF impact_loop

undump          d
write_data      final.data
print           "MD_DONE"
