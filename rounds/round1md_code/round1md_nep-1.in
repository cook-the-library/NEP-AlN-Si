# --- round 1md: round-1wL dataset + frames from MD driven by the round-1wL  ---
# --- NEP itself (melt-quench and collisions, round1md_code/).              ---
# --- Architecture identical to round1wL_nep-1.in, so round1md_nep.sbatch   ---
# --- continues round 1wL's nep.restart (FRESH=1 trains from scratch).      ---
# --- Order N Al Si Ar; LAMMPS pair_coeff must use: N Al Si Ar.             ---
type          4 N Al Si Ar
version       4
cutoff        6 4     # still capped by the 16 A gas-phase boxes (>= 2 x rc)
zbl           2       # ZBL blends in below 2 A
n_max         12 8
basis_size    12 12
l_max         4 2 0
neuron        60

lambda_e      0.1
lambda_f      50
lambda_v      0.1
batch         1000
population    50

# --- continuing from round 1wL needs far fewer generations than a from-   ---
# --- scratch run (round 0 reached its best test force RMSE near 20000).   ---
# --- With FRESH=1, raise this back to round 1wL's 200000.                 ---
generation    100000
